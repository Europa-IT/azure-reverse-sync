{
  "AzureAD": {
    "TenantId": "<your-tenant-id>",
    "ClientId": "<your-app-registration-client-id>",
    "CertificateThumbprint": "<thumbprint-of-cert-in-LocalMachine-My-store>",
    "ClientSecret": ""
  },

  "LocalAD": {
    "Server": "dc01.corp.example.com",
    "TargetOU": "OU=SyncedUsers,DC=corp,DC=example,DC=com",
    "GroupsOU": "OU=SyncedGroups,DC=corp,DC=example,DC=com",
    "DisabledOU": "OU=Disabled,DC=corp,DC=example,DC=com"
  },

  "AttributeMap": {
    "DisplayName":       "DisplayName",
    "GivenName":         "GivenName",
    "Surname":           "Surname",
    "UserPrincipalName": "UserPrincipalName",
    "Mail":              "EmailAddress",
    "Department":        "Department",
    "JobTitle":          "Title",
    "MobilePhone":       "MobilePhone",
    "OfficeLocation":    "Office",
    "CompanyName":       "Company"
  },

  "Kerberos": {
    "Realm": "CORP.EXAMPLE.COM",
    "KeytabOutputPath": "C:\\keytabs",
    "ServiceAccounts": [
      {
        "SamAccountName": "svc-fileserver",
        "FQDN": "fileserver01.corp.example.com",
        "ServiceClass": "cifs"
      },
      {
        "SamAccountName": "svc-nfs",
        "FQDN": "nfsserver01.corp.example.com",
        "ServiceClass": "nfs"
      }
    ]
  },

  "PKINIT": {
    "Enabled": true,
    "CACertificatePath": "C:\\certs\\issuing-ca.cer",
    "CertificateSource": "EntraCBA"
  },

  "Sync": {
    "DryRun": false,
    "DisableDeletedUsers": true,
    "LogPath": ".\\logs\\sync.log"
    "LicensedUsersOnly": false,
    "FilterGroupId": "",
  },

  "ScheduledTask": {
    "TaskName": "AzureSync",
    "IntervalMinutes": 30,
    "RunAsUser": "SYSTEM",
    "SkipKerberos": false,
    "SkipCertificates": false
  }
}
