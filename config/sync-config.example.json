{
  "AzureAD": {
    "TenantId": "<your-tenant-id>",
    "ClientId": "<your-app-registration-client-id>",
    "CertificateThumbprint": "<thumbprint-of-cert-in-LocalMachine-My-store>",
    "ClientSecret": ""
  },

  "LocalAD": {
    "Server": "dc01.corp.example.com",
    "TargetOU": "OU=SyncedUsers,DC=corp,DC=example,DC=com",
    "GroupsOU": "OU=SyncedGroups,DC=corp,DC=example,DC=com",
    "DisabledOU": "OU=Disabled,DC=corp,DC=example,DC=com"
  },

  "AttributeMap": {
    "DisplayName":       "DisplayName",
    "GivenName":         "GivenName",
    "Surname":           "Surname",
    "UserPrincipalName": "UserPrincipalName",
    "Mail":              "EmailAddress",
    "Department":        "Department",
    "JobTitle":          "Title",
    "MobilePhone":       "MobilePhone",
    "OfficeLocation":    "Office",
    "CompanyName":       "Company"
  },

  "Sync": {
    "DryRun": false,
    "DisableDeletedUsers": true,
    "LicensedUsersOnly": false,
    "FilterGroupId": "",
    "AdoptExistingUsers": false
  },

  "ScheduledTask": {
    "TaskName": "AzureSync",
    "IntervalMinutes": 30,
    "RunAsUser": "SYSTEM"
  },

  "Logging": {
    "MaxFiles": 100,
    "LogPath": ".\\logs"
  }
}
